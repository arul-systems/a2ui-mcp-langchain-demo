        { "id": "title", "component": "Text", "text": "Create New Customer", "variant": "h3" },
        {
          "id": "name_field",
          "component": "TextField",
          "label": "Name",
          "value": { "path": "/name" },
          "variant": "shortText"
        },
        {
          "id": "email_field",
          "component": "TextField",
          "label": "Email",
          "value": { "path": "/email" },
          "variant": "shortText"
        },
        {
          "id": "phone_field",
          "component": "TextField",
          "label": "Phone",
          "value": { "path": "/phone" },
          "variant": "shortText"
        },
        {
          "id": "city_field",
          "component": "TextField",
          "label": "City",
          "value": { "path": "/city" },
          "variant": "shortText"
        },
        {
          "id": "country_field",
          "component": "TextField",
          "label": "Country",
          "value": { "path": "/country" },
