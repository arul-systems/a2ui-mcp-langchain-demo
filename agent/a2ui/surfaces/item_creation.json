[
  {
    "createSurface": {
      "surfaceId": "item_creation",
      "sendDataModel": true
    }
  },
  {
    "updateComponents": {
      "surfaceId": "item_creation",
      "components": [
        { "id": "root", "component": "Card", "child": "form_column" },
        {
          "id": "form_column",
          "component": "Column",
          "justify": "start",
          "align": "stretch",
          "children": [
            "title",
            "name_field",
            "description_field",
            "price_field",
            "quantity_field",
            "submit_button"
          ]
        },
        { "id": "title", "component": "Text", "text": "Create New Item", "variant": "h3" },
        {
          "id": "name_field",
          "component": "TextField",
          "label": "Name",
          "value": { "path": "/name" },
          "variant": "shortText",
          "checks": [
            {
              "condition": { "call": "required", "args": { "value": { "path": "/name" } } },
              "message": "Name is required"
            }
          ]
        },
        {
          "id": "description_field",
          "component": "TextField",
          "label": "Description",
          "value": { "path": "/description" },
          "variant": "longText",
          "checks": [
            {
              "condition": { "call": "required", "args": { "value": { "path": "/description" } } },
              "message": "Description is required"
            }
          ]
        },
        {
          "id": "price_field",
          "component": "TextField",
          "label": "Price (USD)",
          "value": { "path": "/price" },
          "variant": "number",
          "checks": [
            {
              "condition": { "call": "required", "args": { "value": { "path": "/price" } } },
              "message": "Price is required"
            },
            {
              "condition": {
                "call": "regex",
                "args": { "value": { "path": "/price" }, "pattern": "^\\d+(\\.\\d{1,2})?$" }
              },
              "message": "Price must be a number 0 or greater (e.g. 10 or 10.50)"
            }
          ]
        },
        {
          "id": "quantity_field",
          "component": "TextField",
          "label": "Quantity in stock",
          "value": { "path": "/quantity" },
          "variant": "number",
          "checks": [
            {
              "condition": { "call": "required", "args": { "value": { "path": "/quantity" } } },
              "message": "Quantity is required"
            },
            {
              "condition": {
                "call": "regex",
                "args": { "value": { "path": "/quantity" }, "pattern": "^\\d+$" }
              },
              "message": "Quantity must be a whole number 0 or greater"
            }
          ]
        },
        { "id": "submit_label", "component": "Text", "text": "Create Item" },
        {
          "id": "submit_button",
          "component": "Button",
          "child": "submit_label",
          "variant": "primary",
          "checks": [
            {
              "condition": {
                "call": "and",
                "args": {
                  "values": [
                    { "call": "required", "args": { "value": { "path": "/name" } } },
                    { "call": "required", "args": { "value": { "path": "/description" } } },
                    { "call": "required", "args": { "value": { "path": "/price" } } },
                    {
                      "call": "regex",
                      "args": { "value": { "path": "/price" }, "pattern": "^\\d+(\\.\\d{1,2})?$" }
                    },
                    { "call": "required", "args": { "value": { "path": "/quantity" } } },
                    {
                      "call": "regex",
                      "args": { "value": { "path": "/quantity" }, "pattern": "^\\d+$" }
                    }
                  ]
                }
              },
              "message": "Please fix the errors above before submitting"
            }
          ],
          "action": {
            "event": {
              "name": "create_item",
              "context": {
                "name": { "path": "/name" },
                "description": { "path": "/description" },
                "price": { "path": "/price" },
                "quantity": { "path": "/quantity" }
              }
            }
          }
        }
      ]
    }
  },
  {
    "updateDataModel": {
      "surfaceId": "item_creation",
      "path": "/",
      "value": { "name": "", "description": "", "price": 0, "quantity": 0 }
    }
  }
]
