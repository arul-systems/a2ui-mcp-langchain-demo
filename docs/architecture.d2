# Architecture of the a2ui-mcp-langchain-demo stack.
# Render with: d2 docs/architecture.d2 docs/architecture.svg

direction: right

user: User {
  shape: person
  icon: https://icons.terrastruct.com/essentials/365-user.svg
}

frontend: agent-ui\n(React + A2UI renderer) {
  icon: https://icons.terrastruct.com/dev/react.svg
}

backend: Agent Backend (Python) {
  api: Azure Function\nfunction_app.py {
    icon: https://icons.terrastruct.com/dev/python.svg
  }
  agent_core: LangChain Agent\nagent.py {
    icon: https://icons.terrastruct.com/dev/python.svg
  }
  a2ui_support: A2UI Processor\na2ui_support.py {
    icon: https://icons.terrastruct.com/dev/python.svg
  }
  customers_db: customers.db\n(SQLite, local file) {
    shape: cylinder
    icon: https://icons.terrastruct.com/essentials/117-database.svg
  }
  customers_mcp: customers-mcp\n(/customers-mcp) {
    icon: https://icons.terrastruct.com/dev/python.svg
  }

  api -> agent_core: run_agent()
  api -> a2ui_support: parse_response()
  agent_core -> customers_mcp: "read_query / write_query\n(HTTP, same Function App)"
  customers_mcp -> customers_db: "SQL"
}

item_mcp: item-mcp\n(own Azure Function, in-memory state) {
  icon: https://icons.terrastruct.com/dev/python.svg
}

llm: OpenAI API\n(LLM) {
  shape: cloud
}

user -> frontend: "interacts with form/chat"
frontend -> backend.api: "POST /chat"
backend.api -> frontend: "{ text, a2ui[] }"
backend.agent_core -> llm: "chat completion"
backend.agent_core -> item_mcp: "list_items / create_item (.mcp.json)"
